// =====================================================================
//  RK4_sistemas_3b_3d.edp
//
//  Método de Runge-Kutta de orden 4 para SISTEMAS aplicado a EDOs de orden superior.
//
//   Ejercicio 3b (EDO de orden 2):
//     t^2 y'' - 2t y' + 2y = t^3 ln t ,  1 <= t <= 2
//     y(1) = 1 , y'(1) = 0 ,  h = 0.1
//     Solución exacta: y(t) = 7/4 t + 1/2 t^3 ln t - 3/4 t^3
//
//   Ejercicio 3d (EDO de orden 3):
//     t^3 y''' - t^2 y'' + 3t y' - 4y = 5t^3 ln t + 9t^3 ,  1 <= t <= 2
//     y(1) = 0 , y'(1) = 1 , y''(1) = 3 ,  h = 0.1
//     Solución exacta: y(t) = -t^2 + t cos(ln t) + t sin(ln t) + t^3 ln t
//
//
//  Ejecución:  FreeFem++ RK4_sistemas_3b_3d.edp
//  (el programa pide los datos por teclado)
// =====================================================================

// ------------------ Variables globales del problema ------------------
int problema = 1;        // 1 -> ejercicio 3b ;  2 -> ejercicio 3d
int m = 2;               // nº de ecuaciones del sistema (= orden de la EDO)
real a = 1., b = 2.;     // intervalo [a,b]
real[int] alfa(3);       // condiciones iniciales y(a), y'(a), y''(a)
string nombre = "3b";

// ---------------------------------------------------------------------
//  F(t,u,du): lado derecho del sistema de primer orden u' = f(t,u).
//  Cambio de variables: u1 = y, u2 = y', u3 = y''  (u[0], u[1], u[2])
// ---------------------------------------------------------------------
func int F(real t, real[int] &u, real[int] &du)
{
    if (problema == 1)
    {
        // 3b:  u1' = u2
        //      u2' = y'' = (t^3 ln t + 2t y' - 2y) / t^2
        //          = 2 u2/t - 2 u1/t^2 + t ln t
        du[0] = u[1];
        du[1] = 2.*u[1]/t - 2.*u[0]/(t*t) + t*log(t);
    }
    else
    {
        // 3d:  u1' = u2 ,  u2' = u3
        //      u3' = y''' = (5t^3 ln t + 9t^3 + t^2 y'' - 3t y' + 4y) / t^3
        //          = u3/t - 3 u2/t^2 + 4 u1/t^3 + 5 ln t + 9
        du[0] = u[1];
        du[1] = u[2];
        du[2] = u[2]/t - 3.*u[1]/(t*t) + 4.*u[0]/(t*t*t) + 5.*log(t) + 9.;
    }
    return 0;
}

// ------------------------- Solución exacta ---------------------------
func real yexacta(real t)
{
    if (problema == 1)
        return 7./4.*t + 0.5*t^3*log(t) - 3./4.*t^3;
    else
        return -t^2 + t*cos(log(t)) + t*sin(log(t)) + t^3*log(t);
}

// ------------------- Carga los datos del ejercicio -------------------
func int configurar(int p)
{
    problema = p;
    a = 1.; b = 2.;
    if (p == 1) { m = 2; alfa[0] = 1.; alfa[1] = 0.; alfa[2] = 0.; nombre = "3b"; }
    else        { m = 3; alfa[0] = 0.; alfa[1] = 1.; alfa[2] = 3.; nombre = "3d"; }
    return 0;
}

// ---------------------------------------------------------------------
//  RK4 para sistemas (Algoritmo 5.7).
//   h      : paso de integración
//   N      : nº total de pasos  (h = (b-a)/N)
//   salto  : cada cuántos pasos se guarda el resultado; así siempre
//            se guardan los valores en los nodos del paso inicial
//            (t = 1.0, 1.1, ..., 2.0) aunque se haya refinado h.
//   W      : salida, W[j] ~ y(a + j*salto*h)
// ---------------------------------------------------------------------
func int RK4sistema(real h, int N, int salto, real[int] &W)
{
    real[int] w(m), k1(m), k2(m), k3(m), k4(m), aux(m), du(m);
    real t = a;
    for (int j = 0; j < m; j++) w[j] = alfa[j];        // w_{j,0} = alfa_j
    W[0] = w[0];

    for (int i = 1; i <= N; i++)
    {
        // k1 = h f(t, w)
        F(t, w, du);
        for (int j = 0; j < m; j++) { k1[j] = h*du[j]; aux[j] = w[j] + 0.5*k1[j]; }
        // k2 = h f(t + h/2, w + k1/2)
        F(t + 0.5*h, aux, du);
        for (int j = 0; j < m; j++) { k2[j] = h*du[j]; aux[j] = w[j] + 0.5*k2[j]; }
        // k3 = h f(t + h/2, w + k2/2)
        F(t + 0.5*h, aux, du);
        for (int j = 0; j < m; j++) { k3[j] = h*du[j]; aux[j] = w[j] + k3[j]; }
        // k4 = h f(t + h, w + k3)
        F(t + h, aux, du);
        for (int j = 0; j < m; j++) k4[j] = h*du[j];

        // w_{i+1} = w_i + (k1 + 2k2 + 2k3 + k4)/6
        for (int j = 0; j < m; j++) w[j] += (k1[j] + 2.*k2[j] + 2.*k3[j] + k4[j])/6.;

        t = a + i*h;                                   // evita acumular redondeo en t
        if (i % salto == 0) W[i/salto] = w[0];         // guarda y en el nodo grueso
    }
    return 0;
}

// ---------------------------------------------------------------------
//  Criterio de "6 decimales exactos" en un nodo:
//   (1) |y - w| < 0.5e-6   (definición clásica de 6 decimales correctos)
//   (2) y, w redondeados a 6 decimales coinciden (los dígitos que se
//       muestran son literalmente los de la solución exacta)
// ---------------------------------------------------------------------
func real red6(real x) { return floor(x*1.e6 + 0.5); }   // redondeo a 6 decimales (x 1e6)
func bool seisDec(real y, real w) { return (abs(y - w) < 0.5e-6) && (red6(y) == red6(w)); }

// --------- Escribe un real con hueco para el signo (alinea columnas) --
func int pr(real x) { if (x >= 0) cout << " "; cout << x; return 0; }

// ---------------------------------------------------------------------
//  Tabla de resultados en los nodos t = a + i*h0
// ---------------------------------------------------------------------
func int tabla(real[int] &W, real h0, int Nc, real h)
{
    cout << endl;
    cout << "  Ejercicio " << nombre << "  -  paso de integracion h = ";
    cout.scientific; cout.precision(4); cout << h << endl;
    string linea = "  ----------------------------------------------------------------------------------------------";
    cout << linea << endl;
    cout << "    t_i      w_i (RK4)       y(t_i) exacta     w_i 6 dec.   y(t_i) 6 dec.   |y(t_i)-w_i|  6 dec?" << endl;
    cout << linea << endl;
    for (int i = 0; i <= Nc; i++)
    {
        real t = a + i*h0, y = yexacta(t), e = abs(y - W[i]);
        string ok = seisDec(y, W[i]) ? "   SI" : "   NO";   // criterio (1) y (2)
        cout.fixed;
        cout << "    "; cout.precision(1); cout << t << "   ";
        cout.precision(10); pr(W[i]); cout << "   ";
        pr(y);    cout << "     ";
        cout.precision(6);  pr(W[i]); cout << "     ";
        pr(y);    cout << "     ";
        cout.scientific; cout.precision(3); cout << e << ok << endl;
    }
    cout << linea << endl;
    return 0;
}

// ---------------------------------------------------------------------
//  Resuelve un ejercicio: tabla con el h del enunciado y, si hace falta,
//  refinamiento h, h/2, h/4, ... hasta conseguir max|error| < tol.
// ---------------------------------------------------------------------
func int resolver(int p, real h0, real tol)
{
    configurar(p);
    int Nc = int((b - a)/h0 + 0.5);                     // nº de nodos gruesos
    real[int] W(Nc+1), W0(Nc+1), err(Nc+1);              // W0: resultado con el h del enunciado
    real errAnt = 0., wbAnt = 0.;

    cout << endl << "=====================================================================================" << endl;
    if (p == 1)
    {
        cout << " EJERCICIO 3b :  t^2 y'' - 2t y' + 2y = t^3 ln t ,  y(1)=1 , y'(1)=0" << endl;
        cout << "   Sistema:  u1' = u2 ;  u2' = 2u2/t - 2u1/t^2 + t ln t" << endl;
    }
    else
    {
        cout << " EJERCICIO 3d :  t^3 y''' - t^2 y'' + 3t y' - 4y = 5t^3 ln t + 9t^3" << endl;
        cout << "                 y(1)=0 , y'(1)=1 , y''(1)=3" << endl;
        cout << "   Sistema:  u1' = u2 ;  u2' = u3 ;  u3' = u3/t - 3u2/t^2 + 4u1/t^3 + 5 ln t + 9" << endl;
    }
    cout << "=====================================================================================" << endl;

    // ---- Estudio de convergencia: se divide h entre 2 hasta cumplir la tolerancia
    cout << endl << "  Estudio de convergencia (error maximo en los nodos t = a + i*h0):" << endl;
    cout << "    k        h        N      max|y-w|     nodos 6 dec.  cociente  Richardson en t=b" << endl;
    int k = 0;
    real h = h0;
    bool conseguido = false;
    for (k = 0; k <= 12; k++)
    {
        int salto = 2^k;
        int N = Nc*salto;
        h = h0/salto;
        RK4sistema(h, N, salto, W);

        real emax = 0.;
        int nOK = 0;                                    // nº de nodos con 6 decimales exactos
        for (int i = 0; i <= Nc; i++)
        {
            real y = yexacta(a + i*h0);
            err[i] = abs(y - W[i]);
            emax = max(emax, err[i]);
            if (seisDec(y, W[i])) nOK++;
        }
        bool todosOK = (nOK == Nc + 1);

        cout << "    " << k << "   "; cout.scientific; cout.precision(4); cout << h << "   ";
        string sN = "" + N; while (sN.length < 4) sN = " " + sN;   // alinea la columna N
        cout << sN << "    "; cout.precision(4); cout << emax;
        string sOK = "" + nOK + "/" + (Nc+1); while (sOK.length < 5) sOK = " " + sOK;
        cout << "     " << sOK;
        if (k > 0)
        {
            // cociente ~ 16 confirma orden 4 (error(h)/error(h/2) = 2^4)
            cout.fixed; cout.precision(2); cout << "      " << errAnt/emax;
            // Richardson: |w_{h/2} - w_h|/15 estima el error SIN usar la solución exacta
            cout.scientific; cout.precision(4); cout << "     " << abs(W[Nc] - wbAnt)/15.;
        }
        cout << endl;

        if (k == 0) W0 = W;                             // guarda la solución con el h del enunciado
        // parada: error máximo < tol  Y  los 6 decimales redondeados coinciden en todos los nodos
        if (emax < tol && todosOK) { conseguido = true; break; }
        errAnt = emax; wbAnt = W[Nc];
    }

    tabla(W0, h0, Nc, h0);                              // tabla con el h del enunciado
    if (conseguido)
    {
        if (k > 0) tabla(W, h0, Nc, h);                 // tabla final con 6 decimales exactos
        cout << endl << "  CONCLUSION (" << nombre << "): con h = ";
        cout.scientific; cout.precision(4); cout << h;
        cout << " el error maximo es < " << tol << endl;
        cout << "  y los valores redondeados coinciden con la solucion exacta en todos los nodos" << endl;
        cout << "  => la columna 'w_i 6 dec.' tiene 6 decimales exactos." << endl;
    }
    else cout << "  No se alcanzo la tolerancia con 12 refinamientos." << endl;

    // ---- Guarda los resultados en fichero de texto
    ofstream fout("resultados_" + nombre + ".txt");
    fout.precision(12);
    fout << "# t   w_i(RK4)   y(t)   |error|    h = " << h << endl;
    for (int i = 0; i <= Nc; i++)
        fout << a + i*h0 << "  " << W[i] << "  " << yexacta(a + i*h0) << "  " << abs(yexacta(a + i*h0) - W[i]) << endl;
    return 0;
}

// =========================== PROGRAMA PRINCIPAL ======================
int opcion;
real h0, tol;

cout << endl << "  RUNGE-KUTTA (orden 4) PARA SISTEMAS - EDOs de orden superior" << endl;
cout << "  ------------------------------------------------------------" << endl;
cout << "   1) Ejercicio 3b  (EDO de orden 2)" << endl;
cout << "   2) Ejercicio 3d  (EDO de orden 3)" << endl;
cout << "   3) Ambos" << endl;
cout << "  Elige opcion: ";                 cin >> opcion;
cout << "  Paso inicial h (enunciado: 0.1): "; cin >> h0;
cout << "  Tolerancia para 6 decimales exactos (0.5e-6): "; cin >> tol;
cout << endl << "  Datos leidos: opcion = " << opcion << " , h = " << h0 << " , tol = " << tol << endl;

if (opcion == 1 || opcion == 3) resolver(1, h0, tol);
if (opcion == 2 || opcion == 3) resolver(2, h0, tol);
